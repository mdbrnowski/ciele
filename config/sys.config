[
    {kernel, [
        {logger_level, notice},
        {logger, [
            {handler, default, logger_std_h, #{
                formatter =>
                    {logger_formatter, #{
                        legacy_header => false,
                        single_line => true,
                        template => [
                            time, " ", "[", level, "]",
                            % {pid, [" ", pid, ""], ""},
                            {mfa, [" ", mfa, ":", line], ""},
                            ": ", msg, "\n"
                        ]
                    }}
            }}
        ]}
    ]}
].
